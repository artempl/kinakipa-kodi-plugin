<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.kinakipa" name="Кінакіпа" version="1.1.1" provider-name="arciom">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="inputstream.adaptive" version="2.0.0" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="be_BY">Фільмы і серыялы па-беларуску</summary>
        <summary lang="en_GB">Belarusian movies and TV series</summary>
        <description lang="be_BY">Глядзіце фільмы, серыялы і мультфільмы з беларускай агучкай або субтытрамі з kinakipa.site. Пошук, каталог, жанры, краіны, гады, новыя эпізоды — усё ўнутры Kodi.</description>
        <description lang="en_GB">Browse and stream movies, TV series and cartoons with Belarusian dubbing or subtitles from kinakipa.site. Search, catalog, genres, countries, years and new episodes — right inside Kodi.</description>
        <license>GPL-2.0-or-later</license>
        <platform>all</platform>
        <news>1.1.1 - выпраўлена адлюстраванне пунктаў фаварытаў
1.1.0 - фаварыты і фіксацыя якасці HLS
1.0.0 - першы выпуск</news>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.kinakipa" name="Кінакіпа Repository" version="1.0.0" provider-name="arciom">
    <extension point="xbmc.addon.repository">
        <dir minversion="19.0.0">
            <info compressed="false">https://artempl.github.io/kinakipa-kodi-plugin/addons.xml</info>
            <checksum>https://artempl.github.io/kinakipa-kodi-plugin/addons.xml.md5</checksum>
            <datadir zip="true">https://artempl.github.io/kinakipa-kodi-plugin/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="be_BY">Рэпазітар плагіна Кінакіпа</summary>
        <summary lang="en_GB">Repository for the Kinakipa add-on</summary>
        <description lang="be_BY">Аўтаматычныя абнаўленні для плагіна «Кінакіпа» — фільмы і серыялы па-беларуску з kinakipa.site.</description>
        <description lang="en_GB">Automatic updates for the Kinakipa add-on — Belarusian movies and TV series from kinakipa.site.</description>
        <license>GPL-2.0-or-later</license>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
</addons>
